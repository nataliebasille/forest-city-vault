# Local development config. `DATABASE_URL` points at local Supabase.
#
# To run migrations against production, create a gitignored `.env.production`
# at the repo root containing the prod connection string, then run
# `pnpm db:migrate:prod`. At minimum it needs:
#   DATABASE_URL=postgresql://<user>:<password>@<prod-host>:5432/postgres
#
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=anon_key
SUPABASE_SECRET_KEY=secret_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CLOVER_APP_ID=your_clover_app_id
CLOVER_SECRET_CODE=your_clover_app_secret
CLOVER_URL=https://apisandbox.dev.clover.com
CLOVER_OAUTH_URL=https://sandbox.dev.clover.com
# Production API hosts (region-specific) for CLOVER_URL: North America
# https://api.clover.com, Europe https://api.eu.clover.com, Latin America
# https://api.la.clover.com. The matching CLOVER_OAUTH_URL is https://www.clover.com
# (NA) / https://www.eu.clover.com / https://www.la.clover.com.
CLOVER_WEBHOOK_AUTH_CODE=your_clover_webhook_auth_code
CLOVER_PROCESSOR_SECRET=change_me_to_a_long_random_secret
CLOVER_TOKEN_ENCRYPTION_KEY=change_me_to_a_long_random_secret
# The single Clover merchant this internal app is allowed to authorize.
# Never commit a real merchant id.
CLOVER_MERCHANT_ID=your_clover_merchant_id
# Optional static Clover API access token for CLOVER_MERCHANT_ID. When set, the
# app talks to the Clover API directly for that merchant (bypassing the OAuth
# token store) — useful for a test merchant whose token was issued outside the
# OAuth app flow. Leave unset for OAuth-only deployments. Never commit a real token.
CLOVER_MERCHANT_ACCESS_TOKEN=
# Exact OAuth callback URL registered as the Clover app's Site URL / redirect URI.
# Must be an absolute URL; must be https in production. Never commit the real one.
CLOVER_OAUTH_REDIRECT_URI=https://your-domain.example/api/oauth/callback
# Secret used to sign the OAuth CSRF state cookie. Must be separate from every
# other Clover secret. Rotating it only invalidates in-progress authorizations.
CLOVER_OAUTH_STATE_SECRET=change_me_to_a_long_random_secret
# Optional throttling for the payments drain. Each inbox message costs two Clover
# API calls (the payment, then its order), so the drain is paced to stay under
# Clover's per-merchant rate limit. CLOVER_DRAIN_BATCH_SIZE caps how many messages
# a single run processes (default 30); CLOVER_DRAIN_MESSAGE_DELAY_MS is the wait
# between messages in milliseconds (default 250). Leave unset to use the defaults.
CLOVER_DRAIN_BATCH_SIZE=30
CLOVER_DRAIN_MESSAGE_DELAY_MS=250

# Marketing site — "Become a vendor" application emails (Resend)
RESEND_API_KEY=your_resend_api_key
VENDOR_APPLICATION_TO_EMAIL=applications@your-domain.com
# Optional; defaults to Resend's shared onboarding@resend.dev sender for testing.
# Use an address on a domain you've verified in Resend for production.
VENDOR_APPLICATION_FROM_EMAIL=onboarding@resend.dev
